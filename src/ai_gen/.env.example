# 方舟（Ark）云端接口凭证模板
# 用法：复制本文件为同目录 .env 后填入真实值
#   cp .env.example .env
# .env 已被本目录 .gitignore 排除，不会随提交入库；请勿把真实密钥写进 .env.example
ARK_API_KEY=ark-"your_ark_api_key_here"

# 文生图（Seedream）接入点 endpoint id，渲染 file_1/file_2 画面
ARK_MODEL=ep-"your_ark_model_name_here"

# 大模型（doubao 系列）接入点 endpoint id，生成案件剧本（可选，缺省回退程序化模板）
ARK_LLM_MODEL=ep-"your_ark_llm_model_here"
